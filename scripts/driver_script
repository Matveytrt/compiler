./objects/front my_progs/test.txt ast_trees/front.txt
./objects/back ast_trees/front.txt test
nasm -f elf64 nasm_code/my_scanf.asm -o my_scanf.o
nasm -f elf64 nasm_code/print.asm -o print.o
nasm -f elf64 nasm_code/printchar.asm -o printchar.o
nasm -f elf64 nasm_code/test.asm -o test.o
gcc test.o my_scanf.o print.o printchar.o -o test -no-pie