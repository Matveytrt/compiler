./objects/front my_progs/fibonacci.txt ast_trees/front.txt
./objects/back ast_trees/front.txt fibonacci
nasm -f elf64 nasm_code/my_scanf.asm -o my_scanf.o
nasm -f elf64 nasm_code/print.asm -o print.o
nasm -f elf64 nasm_code/printchar.asm -o printchar.o
nasm -f elf64 nasm_code/fibonacci.asm -o fibonacci.o
g++ fibonacci.o my_scanf.o print.o printchar.o -o fibonacci -no-pie