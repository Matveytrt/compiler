./objects/front my_progs/fact.txt ast_trees/front.txt
./objects/back ast_trees/front.txt fact
nasm -f elf64 nasm_code/my_scanf.asm -o my_scanf.o
nasm -f elf64 nasm_code/print.asm -o print.o
nasm -f elf64 nasm_code/printchar.asm -o printchar.o
nasm -f elf64 nasm_code/fact.asm -o fact.o
g++ fact.o my_scanf.o print.o printchar.o -o fact -no-pie